{
  "name": "defi-garden",
  "version": "1.0.0",
  "description": "DeFi Garden - Find the best yields for your tokens across all chains",
  "main": "app.js",
  "scripts": {
    "sitemap": "node generate-sitemap.js",
    "sitemap:validate": "node generate-sitemap.js && echo 'Validating sitemap...' && curl -s -o /dev/null -w '%{http_code}' https://www.xml-sitemaps.com/validate-xml-sitemap.html",
    "serve": "npx --yes http-server -p 8000 -c-1",
    "dev": "npx --yes http-server -p 8000 -c-1",
    "generate:llms": "node generate-llms.js",
    "tokens": "node generate-token-pages.js",
    "test": "node test_planner.js && node test_protocol_parsing.js && node test_qualifier_fix.js && node test_smoke.js && node test_canonical.js && node test_search.js && node test_token_pages.js && node test_indexnow.js && node test_stories.js"
  },
  "keywords": [
    "defi",
    "yield-farming",
    "cryptocurrency",
    "apy",
    "tvl",
    "lending",
    "staking",
    "liquidity-pools",
    "defillama",
    "ethereum",
    "polygon",
    "avalanche",
    "arbitrum",
    "optimism"
  ],
  "author": "DeFi Garden",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alex0xhodler/defi_garden.git"
  },
  "homepage": "https://www.defi.garden",
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "fast-xml-parser": "^4.4.1"
  },
  "devDependencies": {
    "@babel/standalone": "^8.0.4",
    "playwright": "^1.61.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
