{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "has": [
        { "type": "query", "key": "app" }
      ],
      "destination": "/home"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "Accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "missing": [
        { "type": "query", "key": "token" },
        { "type": "query", "key": "chain" },
        { "type": "query", "key": "pool" },
        { "type": "query", "key": "protocols" },
        { "type": "query", "key": "poolTypes" },
        { "type": "query", "key": "minTvl" },
        { "type": "query", "key": "minApy" },
        { "type": "query", "key": "goal" },
        { "type": "query", "key": "monthly" },
        { "type": "query", "key": "years" },
        { "type": "query", "key": "pace" },
        { "type": "query", "key": "preset" },
        { "type": "query", "key": "fresh" },
        { "type": "query", "key": "capital" },
        { "type": "query", "key": "fm" },
        { "type": "query", "key": "dl" }
      ],
      "destination": "/llms.txt"
    },
    {
      "source": "/",
      "destination": "/home"
    },
    {
      "source": "/index.html",
      "destination": "/home"
    },
    {
      "source": "/index",
      "destination": "/home"
    },
    {
      "source": "/.well-known/api-catalog",
      "destination": "/.well-known/api-catalog.json"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/.well-known/oauth-authorization-server.json"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/.well-known/oauth-protected-resource.json"
    },
    {
      "source": "/.well-known/openid-configuration",
      "destination": "/.well-known/openid-configuration.json"
    },
    {
      "source": "/.well-known/acp",
      "destination": "/.well-known/acp.json"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "^(www\\.)?yield\\.garden$" }],
      "destination": "https://www.defi.garden/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "^(www\\.)?yield\\.garden$" }],
      "destination": "https://www.defi.garden/:path*",
      "permanent": true
    },
    {
      "source": "/ai-info",
      "has": [
        {
          "type": "header",
          "key": "Accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "destination": "/ai-info.md",
      "permanent": false
    },
    {
      "source": "/tokens/index",
      "destination": "/tokens",
      "permanent": true
    },
    {
      "source": "/chains/index",
      "destination": "/chains",
      "permanent": true
    },
    {
      "source": "/ko/tokens/index",
      "destination": "/ko/tokens",
      "permanent": true
    },
    {
      "source": "/ko/chains/index",
      "destination": "/ko/chains",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        { "type": "header", "key": "Accept", "value": "(.*)text/markdown(.*)" },
        { "type": "query", "key": "pool", "value": "(?<poolId>[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})" }
      ],
      "destination": "/pools/:poolId.md",
      "permanent": false
    },
    {
      "source": "/tokens/:slug([^/.]+)",
      "has": [
        {
          "type": "header",
          "key": "Accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "destination": "/tokens/:slug.md",
      "permanent": false
    },
    {
      "source": "/chains/:slug([^/.]+)",
      "has": [
        {
          "type": "header",
          "key": "Accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "destination": "/chains/:slug.md",
      "permanent": false
    },
    {
      "source": "/ko/tokens/:slug([^/.]+)",
      "has": [
        {
          "type": "header",
          "key": "Accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "destination": "/ko/tokens/:slug.md",
      "permanent": false
    },
    {
      "source": "/ko/chains/:slug([^/.]+)",
      "has": [
        {
          "type": "header",
          "key": "Accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "destination": "/ko/chains/:slug.md",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Signal", "value": "search=yes, ai-train=no, use=reference" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Accept, Authorization" },
        { "key": "Link", "value": "</sitemap.xml>; rel=\"sitemap\"; type=\"application/xml\", </llms.txt>; rel=\"llms-txt\"; type=\"text/markdown\", </ai-info>; rel=\"ai-info\"; type=\"text/html\", </.well-known/api-catalog>; rel=\"api-catalog\"; type=\"application/linkset+json\", </.well-known/agent-skills/index.json>; rel=\"agent-skills\"; type=\"application/json\", </.well-known/mcp/server-card.json>; rel=\"mcp-server-card\"; type=\"application/json\", </.well-known/acp.json>; rel=\"acp\"; type=\"application/json\", </.well-known/oauth-protected-resource>; rel=\"oauth-protected-resource\"; type=\"application/json\", </.well-known/oauth-authorization-server>; rel=\"oauth-authorization-server\"; type=\"application/json\", </.well-known/openid-configuration>; rel=\"openid-configuration\"; type=\"application/json\"" }
      ]
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "Accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "missing": [
        { "type": "query", "key": "token" },
        { "type": "query", "key": "chain" },
        { "type": "query", "key": "pool" },
        { "type": "query", "key": "protocols" },
        { "type": "query", "key": "poolTypes" },
        { "type": "query", "key": "minTvl" },
        { "type": "query", "key": "minApy" },
        { "type": "query", "key": "goal" },
        { "type": "query", "key": "monthly" },
        { "type": "query", "key": "years" },
        { "type": "query", "key": "pace" },
        { "type": "query", "key": "preset" },
        { "type": "query", "key": "fresh" },
        { "type": "query", "key": "capital" },
        { "type": "query", "key": "fm" },
        { "type": "query", "key": "dl" }
      ],
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "Vary", "value": "Accept" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "Accept",
          "value": "(.*)text/markdown(.*)"
        },
        { "type": "query", "key": "app" }
      ],
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" },
        { "key": "Vary", "value": "Accept" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Vary", "value": "Accept" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/ai-info",
      "has": [
        {
          "type": "header",
          "key": "Accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "Vary", "value": "Accept" }
      ]
    },
    {
      "source": "/ai-info",
      "headers": [
        { "key": "Vary", "value": "Accept" }
      ]
    },
    {
      "source": "/tokens/:slug([^/.]+)",
      "has": [
        {
          "type": "header",
          "key": "Accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "headers": [
        { "key": "Vary", "value": "Accept" }
      ]
    },
    {
      "source": "/chains/:slug([^/.]+)",
      "has": [
        {
          "type": "header",
          "key": "Accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "headers": [
        { "key": "Vary", "value": "Accept" }
      ]
    },
    {
      "source": "/ko/tokens/:slug([^/.]+)",
      "has": [
        {
          "type": "header",
          "key": "Accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "headers": [
        { "key": "Vary", "value": "Accept" }
      ]
    },
    {
      "source": "/ko/chains/:slug([^/.]+)",
      "has": [
        {
          "type": "header",
          "key": "Accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "headers": [
        { "key": "Vary", "value": "Accept" }
      ]
    },
    {
      "source": "/(.*)\\.md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/tokens/:slug",
      "headers": [
        { "key": "Vary", "value": "Accept" }
      ]
    },
    {
      "source": "/chains/:slug",
      "headers": [
        { "key": "Vary", "value": "Accept" }
      ]
    },
    {
      "source": "/ko/tokens/:slug",
      "headers": [
        { "key": "Vary", "value": "Accept" }
      ]
    },
    {
      "source": "/ko/chains/:slug",
      "headers": [
        { "key": "Vary", "value": "Accept" }
      ]
    },
    {
      "source": "/home",
      "headers": [
        { "key": "Vary", "value": "Accept" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/.well-known/api-catalog",
      "headers": [
        { "key": "Content-Type", "value": "application/linkset+json; charset=utf-8" }
      ]
    },
    {
      "source": "/.well-known/api-catalog.json",
      "headers": [
        { "key": "Content-Type", "value": "application/linkset+json; charset=utf-8" }
      ]
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" }
      ]
    },
    {
      "source": "/.well-known/oauth-authorization-server.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" }
      ]
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" }
      ]
    },
    {
      "source": "/.well-known/oauth-protected-resource.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" }
      ]
    },
    {
      "source": "/.well-known/openid-configuration",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" }
      ]
    },
    {
      "source": "/.well-known/openid-configuration.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" }
      ]
    },
    {
      "source": "/.well-known/mcp/server-card.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" }
      ]
    },
    {
      "source": "/.well-known/agent-skills/index.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=600" }
      ]
    }
  ]
}
