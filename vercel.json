{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "has": [
        { "type": "query", "key": "app" }
      ],
      "destination": "/home"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "Accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "missing": [
        { "type": "query", "key": "token" },
        { "type": "query", "key": "chain" },
        { "type": "query", "key": "pool" },
        { "type": "query", "key": "protocols" },
        { "type": "query", "key": "poolTypes" },
        { "type": "query", "key": "minTvl" },
        { "type": "query", "key": "minApy" },
        { "type": "query", "key": "goal" },
        { "type": "query", "key": "monthly" },
        { "type": "query", "key": "years" },
        { "type": "query", "key": "pace" },
        { "type": "query", "key": "preset" },
        { "type": "query", "key": "fresh" },
        { "type": "query", "key": "capital" },
        { "type": "query", "key": "fm" },
        { "type": "query", "key": "dl" }
      ],
      "destination": "/llms.txt"
    },
    {
      "source": "/",
      "destination": "/home"
    },
    {
      "source": "/index.html",
      "destination": "/home"
    },
    {
      "source": "/index",
      "destination": "/home"
    },
    {
      "source": "/mcp",
      "has": [
        { "type": "header", "key": "accept", "value": "(.*)text/html(.*)" }
      ],
      "missing": [
        { "type": "header", "key": "content-type", "value": "(.*)application/json(.*)" }
      ],
      "destination": "/mcp-page"
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/.well-known/api-catalog",
      "destination": "/.well-known/api-catalog.json"
    },
    {
      "source": "/.well-known/ai-catalog",
      "destination": "/.well-known/ai-catalog.json"
    },
    {
      "source": "/api/laso/:match*",
      "destination": "https://laso.finance/:match*"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "^defi\\.garden$" }],
      "destination": "https://www.defi.garden/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "^defi\\.garden$" }],
      "destination": "https://www.defi.garden/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "^(www\\.)?yield\\.garden$" }],
      "destination": "https://www.defi.garden/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "^(www\\.)?yield\\.garden$" }],
      "destination": "https://www.defi.garden/:path*",
      "permanent": true
    },
    {
      "source": "/agents",
      "destination": "/mcp",
      "permanent": true
    },
    {
      "source": "/ai-info",
      "destination": "/mcp",
      "permanent": true
    },
    {
      "source": "/auth.md",
      "destination": "/mcp",
      "permanent": true
    },
    {
      "source": "/guide/defi-yield-rates-explained",
      "has": [
        {
          "type": "header",
          "key": "Accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "destination": "/guide/defi-yield-rates-explained.md",
      "permanent": false
    },
